# ============================================================================
# scanapp — .gitignore
#
# MAINTENANCE RULE (also encoded in CLAUDE.md):
# Whenever a new tool, package, or codegen step is added to this project, add
# its artifacts here in the SAME change. Never `git add -f` a build artifact.
# Sections are ordered: Dart/Flutter → codegen → secrets → platforms → tooling.
# ============================================================================

# ---------------------------------------------------------------------------
# Dart & Flutter
# ---------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
**/doc/api/
**/ios/Flutter/.last_build_id
.widget_preview/
migrate_working_dir/
*.lock.bak

# Keep pubspec.lock for an APPLICATION (pin exact deps for reproducible builds).
# If this ever becomes a package/library, uncomment the next line instead.
# pubspec.lock

# ---------------------------------------------------------------------------
# Generated code (build_runner: freezed / json_serializable / riverpod)
# Regenerate with: dart run build_runner build --delete-conflicting-outputs
# Rationale in docs/DECISIONS.md (ADR-0003).
# ---------------------------------------------------------------------------
*.g.dart
*.freezed.dart
*.gr.dart
*.config.dart
*.mocks.dart
*.gen.dart

# ---------------------------------------------------------------------------
# Test, coverage & profiling output
# ---------------------------------------------------------------------------
coverage/
/coverage/
lcov.info
test/**/failures/
**/failures/
*.timeline.json
*.timeline_summary.json

# ---------------------------------------------------------------------------
# Secrets, credentials & environment
# NEVER commit these. Commit the *.example variants instead.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.p8
*.jks
*.keystore
key.properties
secrets.dart
**/secrets/
service-account*.json
google-services.json
GoogleService-Info.plist
firebase_options.dart
.firebase/

# ---------------------------------------------------------------------------
# Symbolication & obfuscation
# ---------------------------------------------------------------------------
app.*.symbols
app.*.map.json
*.symbols

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------
android/.gradle/
android/.kotlin/
android/captures/
android/local.properties
android/key.properties
android/app/debug/
android/app/profile/
android/app/release/
android/app/src/main/assets/flutter_assets/
/android/app/debug
/android/app/profile
/android/app/release
*.apk
*.aab
*.ap_
*.dex
*.class

# ---------------------------------------------------------------------------
# iOS / macOS
# ---------------------------------------------------------------------------
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/
**/Pods/
**/Podfile.lock
*.ipa
*.dSYM.zip
*.dSYM
xcuserdata/
**/*.xcworkspace/xcuserdata/
**/DerivedData/
.swiftpm/

# ---------------------------------------------------------------------------
# Linux / Windows desktop
# ---------------------------------------------------------------------------
linux/flutter/ephemeral/
windows/flutter/ephemeral/
*.exe
*.msix

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
web/main.dart.js*
lib/generated_plugin_registrant.dart

# ---------------------------------------------------------------------------
# IDE & editors
# ---------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/tasks.json
*.swp
*.swo
*~
.history/
.atom/
.svn/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs, temp & scratch
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
.scratch/
tmp/

# ---------------------------------------------------------------------------
# Claude Code — share team config, ignore per-developer state
# ---------------------------------------------------------------------------
.claude/settings.local.json
.claude/memory/
.claude/.cache/
